generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime? 
  image         String?
  referralCode  String        @unique @default(cuid())
  pb            Int           @default(0)
  reviewCount   Int           @default(0)
  createdAt     DateTime      @default(now())
  accounts      Account[]
  reviews       Review[]
  applications  Application[]
  winners       Winner[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Store {
  id            Int       @id @default(autoincrement())
  name          String
  category      String
  area          String
  address       String
  hours         String
  emoji         String
  bg            String    @default("#FEF3C7")
  ac            String    @default("#D97706")
  tag           String
  naverUrl      String?
  desc          String?
  pb            Int       @default(10)
  lat           Float
  lng           Float
  certified     Boolean   @default(false)
  active        Boolean   @default(true)
  contractStart DateTime
  contractWeeks Int       @default(3)
  monthlyFee    Int       @default(100000)
  createdAt     DateTime  @default(now())
  reviews       Review[]
}

model Review {
  id            Int      @id @default(autoincrement())
  userId        String
  storeId       Int?
  storeName     String
  platform      String
  menu          String?
  people        Int?
  amount        Int?
  screenshotUrl String?
  status        String   @default("pending")
  pbAwarded     Int      @default(0)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])
  store         Store?   @relation(fields: [storeId], references: [id])
}

model Prize {
  id           Int           @id @default(autoincrement())
  name         String
  emoji        String
  bg           String        @default("#F0F0F5")
  value        String
  cost         Int
  maxWinners   Int
  maxApply     Int           @default(500)
  active       Boolean       @default(true)
  weekStart    DateTime      @default(now())
  createdAt    DateTime      @default(now())
  applications Application[]
  winners      Winner[]
}

model Application {
  id        Int      @id @default(autoincrement())
  userId    String
  prizeId   Int
  count     Int      @default(1)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  prize     Prize    @relation(fields: [prizeId], references: [id])
  @@unique([userId, prizeId])
}

model Winner {
  id        Int      @id @default(autoincrement())
  userId    String
  prizeId   Int
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  prize     Prize    @relation(fields: [prizeId], references: [id])
}

model Notice {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  type      String   @default("notice")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}